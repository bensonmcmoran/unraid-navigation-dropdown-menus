<script>
(() => {
    'use strict';

    const button = document.getElementById('jnd-settings-apply');
    const status = document.getElementById('jnd-settings-status');
    const controls = Array.from(document.querySelectorAll('[data-jnd-setting]'));

    if (!button || !status || !controls.length || !window.jQuery) return;

    const byId = (id) => document.getElementById(id);
    const saved = new Map(controls.map(control => [control.id, control.value]));
    const enabled = (id) => byId(id)?.value === '1';

    const setDisabled = (id, disabled) => {
        const control = byId(id);
        if (!control) return;
        control.disabled = !!disabled;
        control.setAttribute('aria-disabled', disabled ? 'true' : 'false');
    };

    const syncDependencies = () => {
        const mainEnabled = enabled('jnd-dropdown-main');
        const dockerEnabled = enabled('jnd-dropdown-docker');
        const vmEnabled = enabled('jnd-dropdown-vms');
        const dockerStatusEnabled = enabled('jnd-docker-status');
        const vmStatusEnabled = enabled('jnd-vm-status');
        const dockerQuickEnabled = enabled('jnd-docker-quick');
        const vmQuickEnabled = enabled('jnd-vm-quick');
        const dockerWebUiEnabled = enabled('jnd-docker-webui');

        setDisabled('jnd-show-ud', !mainEnabled);

        setDisabled('jnd-docker-status', !dockerEnabled);
        setDisabled('jnd-docker-quick', !dockerEnabled || !dockerStatusEnabled);
        setDisabled('jnd-docker-confirm', !dockerEnabled || !dockerStatusEnabled || !dockerQuickEnabled);
        setDisabled('jnd-docker-logs', !dockerEnabled);
        setDisabled('jnd-docker-webui', !dockerEnabled);
        setDisabled('jnd-webui-new-tab', !dockerEnabled || !dockerWebUiEnabled);

        setDisabled('jnd-vm-status', !vmEnabled);
        setDisabled('jnd-vm-quick', !vmEnabled || !vmStatusEnabled);
        setDisabled('jnd-vm-confirm', !vmEnabled || !vmStatusEnabled || !vmQuickEnabled);
        setDisabled('jnd-vm-vnc', !vmEnabled);
        setDisabled('jnd-vm-logs', !vmEnabled);
    };

    const changed = () => controls.some(control => control.value !== saved.get(control.id));

    const syncApply = () => {
        button.disabled = !changed();
    };

    const onSettingChange = () => {
        status.textContent = '';
        syncDependencies();
        setTimeout(syncApply, 0);
    };

    controls.forEach(control => control.addEventListener('change', onSettingChange));

    syncDependencies();
    button.disabled = true;
    setTimeout(syncApply, 0);

    button.addEventListener('click', () => {
        if (!changed()) return;

        const payload = {};
        for (const control of controls) {
            payload[control.dataset.jndSetting] = control.value;
        }

        button.disabled = true;
        status.textContent = 'Saving...';

        window.jQuery.ajax({
            url: '/plugins/nav.dropdown.menus/settings.php',
            type: 'POST',
            dataType: 'json',
            data: payload,
        }).done((data) => {
            if (!data || data.ok !== true) {
                status.textContent = 'Save failed.';
                setTimeout(syncApply, 0);
                return;
            }

            status.textContent = 'Saved. Reloading...';
            setTimeout(() => window.location.reload(), 450);
        }).fail((xhr) => {
            let message = 'Save failed.';
            try {
                const data = JSON.parse(xhr.responseText || '{}');
                if (data.error) message += ` ${data.error}`;
            } catch (_) {}

            status.textContent = message;
            setTimeout(syncApply, 0);
        });
    });
})();
</script>
