}
@media (max-width: 720px) {
    #jnd-settings-root table.jnd-settings-table,
    #jnd-settings-root table.jnd-settings-table tbody,
    #jnd-settings-root table.jnd-settings-table tr,
    #jnd-settings-root table.jnd-settings-table td {
        display: block;
        width: 100% !important;
    }
